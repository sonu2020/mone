<style>
  /* Heartbeat shine — a subtle, living pulse of light on hover.
     Rhythmic double-beat (lub-dub) ramps brightness + a soft luminous
     bloom, then settles. Uses currentColor so the shine matches each
     instance's accent (azure / azure-light) automatically. */
  .logo-beam {
    transition: filter 180ms ease-out;
    will-change: filter;
  }
  .logo-beam:hover {
    animation: logo-heartbeat 1.6s ease-in-out infinite;
  }
  @keyframes logo-heartbeat {
    0%, 100% {
      filter: brightness(1) drop-shadow(0 0 0 transparent);
    }
    8% {
      filter: brightness(1.35)
        drop-shadow(0 0 3px color-mix(in oklch, currentColor 45%, transparent));
    }
    16% {
      filter: brightness(1) drop-shadow(0 0 0 transparent);
    }
    24% {
      filter: brightness(1.25)
        drop-shadow(0 0 2px color-mix(in oklch, currentColor 35%, transparent));
    }
    32% {
      filter: brightness(1) drop-shadow(0 0 0 transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-beam:hover {
      animation: none;
      filter: brightness(1.2);
    }
  }
