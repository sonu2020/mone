---
// DESIGN · Shell — the chrome for every design-system page. Deliberately not the
// site Header/Footer: these pages document the newsroom rather than being part
// of it, so they carry their own masthead (logo + wordmark + section nav) and a
// slim colophon. One shell keeps the four sub-pages reading as one document.
import Layout from "../../layouts/Layout.astro";
import Logo from "../Logo.astro";

export interface Props {
  title: string; // <title> text
  description?: string;
  eyebrow?: string; // small label above the page heading
  heading: string; // page H1
  lede?: string; // one paragraph under the H1
  active:
    | "overview"
    | "foundations"
    | "tokens"
    | "layout"
    | "gallery"
    | "components"
    | "archive";
  contained?: boolean; // wrap the slot in the standard page container
  noindex?: boolean; // internal design tools and previews
}
const {
  title,
  description,
  eyebrow,
  heading,
  lede,
  active,
  contained = true,
  noindex = false,
} = Astro.props;

const nav = [
  { id: "overview", label: "Overview", href: "/design", note: "Principles" },
  {
    id: "foundations",
    label: "Foundations",
    href: "/design/system",
    note: "Tokens",
  },
  {
    id: "tokens",
    label: "Tokens",
    href: "/design/tokens",
    note: "Browse & copy",
  },
  {
    id: "layout",
    label: "Layout",
    href: "/design/layout",
    note: "Grid & composition",
  },
  {
    id: "gallery",
    label: "Gallery",
    href: "/design/kitchen",
    note: "Atoms → bands",
  },
  {
    id: "components",
    label: "Catalogue",
    href: "/design/components",
    note: "Props & API",
  },
  { id: "fonts", label: "Fonts", href: "/demo/fonts", note: "Type trial" },
  {
    id: "archive",
    label: "Archive",
    href: "/design/archive",
    note: "Superseded",
  },
];
---

<Layout title={title} description={description} topAd={false} noindex={noindex}>
  <!-- ══ DESIGN SYSTEM MASTHEAD ══ -->
  <header
    class="sticky top-0 z-40 bg-bg-card/95 backdrop-blur border-b border-rule dark:border-ivory/10"
  >
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 h-14">
        <a href="/design" class="flex items-center gap-3 shrink-0 group">
          <Logo class="h-6 w-auto text-ink dark:text-ivory" />
          <span
            class="hidden sm:block h-5 w-px bg-rule dark:bg-ivory/15"
            aria-hidden="true"></span>
          <span
            class="band-label text-[0.8125rem] text-text-navy-deep dark:text-ivory group-hover:text-azure transition-colors"
          >
            Design System
          </span>
        </a>

        <a
          href="/"
          class="ml-auto shrink-0 eyebrow text-text-muted dark:text-ivory/40 hover:text-azure transition-colors"
          >View site ↗</a
        >
      </div>

      <!-- Section nav — scrolls horizontally on small screens rather than wrapping -->
      <nav
        class="-mb-px flex items-stretch gap-1 overflow-x-auto scrollbar-none"
        aria-label="Design system"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={item.id === active ? "page" : undefined}
              class:list={[
                "shrink-0 border-b-2 px-3 py-2.5 transition-colors",
                item.id === active
                  ? "border-azure text-azure"
                  : "border-transparent text-text-secondary dark:text-ivory/60 hover:text-azure hover:border-rule",
              ]}
            >
              <span class="block article-title font-semibold">
                {item.label}
              </span>
              <span class="block caption-text text-text-muted dark:text-ivory/35">
                {item.note}
              </span>
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <main class="flex-1 bg-bg-page">
    <!-- Page head -->
    <section class="bg-bg-card border-b border-rule dark:border-ivory/10">
      <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
        {eyebrow && <p class="eyebrow text-azure">{eyebrow}</p>}
        <h1 class="mt-3 text-hero font-bold text-ink dark:text-ivory">
          {heading}
        </h1>
        {
          lede && (
            <p class="mt-4 lead-text text-text-secondary dark:text-ivory/70 max-w-prose">
              {lede}
            </p>
          )
        }
        <slot name="head" />
      </div>
    </section>

    {
      contained ? (
        <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
  </main>

  <!-- ══ COLOPHON ══ -->
  <footer class="border-t border-rule dark:border-ivory/10 bg-bg-card">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-wrap items-baseline gap-x-8 gap-y-3">
        <p class="eyebrow text-text-muted dark:text-ivory/40">
          MediaOne Design System
        </p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Design system">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="body-small text-text-secondary dark:text-ivory/60 hover:text-azure transition-colors"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="/"
            class="body-small text-azure hover:text-azure-dark transition-colors"
            >Homepage</a
          >
        </nav>
      </div>
      <p
        class="mt-4 caption-text text-text-muted dark:text-ivory/35 max-w-prose"
      >
        Every token lives in one <code class="font-mono">@theme</code> block in
        <code class="font-mono">src/styles/app.css</code> — change it there and it
        propagates here and to the site.
      </p>
    </div>
  </footer>
</Layout>
