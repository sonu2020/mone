// Determine a stable index based on seed/w/h to distribute images consistently
const getStableIndex = (str: string) => {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = str.charCodeAt(i) + ((hash << 5) - hash);
  }
  return Math.abs(hash);
};

const imageKey = seed || `${w}x${h}`;
const index = getStableIndex(imageKey) % realImages.length;
const src = customSrc || realImages[index];
---

<div class:list={['mc', `overflow-hidden bg-placeholder ${className}`]}>
  <img
    src={src}
    alt=""
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={loading === 'eager' ? 'sync' : 'async'}
    class="w-full h-full object-cover"
    width={w}
    height={h}
  />
</div>