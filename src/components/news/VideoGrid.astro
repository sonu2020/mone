---
// BLOCK · VideoGrid — a disciplined grid of landscape VideoCards.
import VideoCard from './VideoCard.astro';
import type { VideoItem } from '../../lib/video-data';
export interface Props {
  items: VideoItem[];
  cols?: 2 | 3 | 4;
  class?: string;
}
const { items, cols = 3, class: className = '' } = Astro.props;
const colCls = {
  2: 'lg:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[cols];
---
<div class:list={['mc', 'grid grid-cols-2 gap-x-6 gap-y-7', colCls, className]}>
  {items.map((v) => <VideoCard item={v} />)}
</div>
