---
// ── /latest-news/page/N · the river, pages 2+ ────────────────────────────────
// Page 1 stays at the bare /latest-news, which keeps the canonical URL clean.
// Same arrangement as /<section>/page/N, and for the same reasons: under
// /page/ so these can't collide with anything published beneath the path, and
// noindex because each is a slice of one list whose first page is the URL worth
// ranking. rel=prev/next on DeskPage's controls still ties the set together.
import Layout from '../../../layouts/Layout.astro';
import HeaderBar from '../../../components/nav/HeaderBar.astro';
import SectionSubNav from '../../../components/nav/SectionSubNav.astro';
import Footer from '../../../components/Footer.astro';
import VideoModal from '../../../components/VideoModal.astro';
import ScheduleList from '../../../components/live/ScheduleList.astro';
import DeskPage from '../../../components/desk/DeskPage.astro';

import { getLatestDesk, getDeskPage, pageCountFor, LATEST_DESK_ID } from '../../../lib/desk';
import { latest } from '../../../lib/home4-data';
import { allVideos, todaysVideos } from '../../../lib/videos';
import { toModalVideos, modalShows, type ModalVideo } from '../../../lib/video-modal';
import { LIVE_CHANNEL } from '../../../lib/live-tv';

export async function getStaticPaths() {
  const count = pageCountFor(getLatestDesk());
  // Page 1 is served by /latest-news, so start at 2.
  return Array.from({ length: Math.max(count - 1, 0) }, (_, i) => ({
    params: { n: String(i + 2) },
  }));
}

const { n } = Astro.params;
const desk = getLatestDesk();
const page = getDeskPage(desk, Number(n));

// The modal doubles as a video browser, so it needs more than a queue.
const modalToday = todaysVideos().map((v) => ({
  id: v.slug,
  title: v.title,
  time: v.publishTime,
  poster: v.thumbnailUrl || '',
}));
const shows = await modalShows();

const liveModalVideo: ModalVideo = {
  id: LIVE_CHANNEL.id,
  title: `${LIVE_CHANNEL.titleML} | ${LIVE_CHANNEL.title}`,
  category: 'Live TV',
  meta: 'Streaming now · 24×7',
  poster: LIVE_CHANNEL.poster,
  src: '',
  embedUrl: LIVE_CHANNEL.embedUrl,
  isLive: true,
};
---

<Layout
  title={`${desk.labelML} | ${desk.label} — Page ${page.page} — MediaOne`}
  description={desk.description}
  adTone="gray"
  noindex
>
  <HeaderBar isBreaking={false} showTopics={false} liveUnit />
  <SectionSubNav pathname={`/${LATEST_DESK_ID}`} />

  <main class="flex-1 bg-bg-page">
    <DeskPage
      desk={desk}
      page={page}
      videos={allVideos.slice(0, 5)}
      trending={latest.slice(0, 5)}
      latest={latest.slice(5, 11)}
      latestViewAllHref={null}
    />
  </main>

  <Footer />

  <VideoModal videos={[liveModalVideo, ...toModalVideos(allVideos)]} today={modalToday} programs={shows}>
    <ScheduleList slot="live-panel" tone="dark" />
  </VideoModal>
</Layout>
