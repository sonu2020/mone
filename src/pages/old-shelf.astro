---
// ── /old-shelf · archived ────────────────────────────────────────────────────
// The previous /shelf: a five-across featured strip over five identical
// three-column category grids. Superseded by the spacious rebuild at /shelf,
// which gives each section a layout suited to what it holds. Kept rendering,
// per the repo's old-* convention, so the two can be compared side by side.
//
// Original header follows.
// ── /shelf · MediaOne Shelf ──────────────────────────────────────────────────
// The long-form collection, on the standard inner-page chrome. Its own taxonomy
// drives the sub-nav rather than the top-level IA: Shelf's eight categories are
// real pages, and the "More" desk that owns /shelf in mega-nav carries news
// desks (Tech, Auto, Education) that have nothing to do with browsing Shelf.
// SubNavBar takes either source, so the strip looks identical either way.
import Layout from '../layouts/Layout.astro';
import Header from '../components/nav/HeaderBar.astro';
import SubNavBar from '../components/nav/SubNavBar.astro';
import DeskMasthead from '../components/desk/DeskMasthead.astro';
import BandHeading from '../components/home4/BandHeading.astro';
import Footer from '../components/Footer.astro';
import { shelfNav } from '../lib/site-sections';
import { shelfFeatured, shelfSections } from '../lib/shelf';

const storyCount =
  shelfFeatured.length + shelfSections.reduce((acc, s) => acc + s.articles.length, 0);
---

<Layout title="SHELF (archived) — MediaOne" description="In-depth stories, interviews, analysis, and features from MediaOne Shelf.">
  <Header isBreaking={false} showTopics={false} liveUnit />
  <SubNavBar links={[...shelfNav]} allHref="/shelf" label="Shelf categories" />

  <main class="flex-1 bg-bg-page">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 bg-bg-card">
      <DeskMasthead
        title="Shelf"
        description={`In-depth stories, interviews, analysis and features — ${storyCount} pieces.`}
      />
    </div>

    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
      <!-- Featured Articles Row -->
      {shelfFeatured.length > 0 && (
        <section class="mb-10 md:mb-14">
          <BandHeading label="Featured" href="/shelf" viewAllHref="/shelf" class="mb-5" />
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
            {shelfFeatured.map((article) => (
              <a href={`/shelf/${article.slug}`} class="group block">
                <div class="relative aspect-[3/2] overflow-hidden rounded-sm bg-placeholder">
                  <img
                    src={article.image}
                    alt={article.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                <div class="mt-2.5">
                  <span class="eyebrow text-azure text-[10px]">{article.category}</span>
                  <h3 class="mt-1 article-title text-text-primary group-hover:text-azure transition-colors line-clamp-2 text-sm leading-snug">
                    {article.title}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Category Sections -->
      <div class="space-y-10 md:space-y-14">
        {shelfSections.map((section) => (
          <section>
            <BandHeading label={section.title} href={section.href} viewAllHref={section.href} class="mb-5" />
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
              {section.articles.map((article) => (
                <article>
                  <a href={`/shelf/${article.slug}`} class="group block">
                    <div class="relative aspect-[3/2] overflow-hidden rounded-sm bg-placeholder">
                      <img
                        src={article.image}
                        alt={article.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    </div>
                    <div class="mt-3">
                      <div class="flex items-center gap-2 text-[11px] text-text-muted">
                        <span class="font-semibold text-ink-light dark:text-ivory/70">{article.author}</span>
                        <span>·</span>
                        <span class="eyebrow text-azure">{article.category}</span>
                      </div>
                      <h3 class="mt-1.5 article-title text-text-primary group-hover:text-azure transition-colors line-clamp-2 leading-snug">
                        {article.title}
                      </h3>
                      <p class="mt-1 caption-text text-text-muted tabular-nums">{article.date}</p>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
