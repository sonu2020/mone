---
// BLOCK · NumberedList — ranked headlines (Most read / Top 10). Oversized azure
// ordinal + headline. Optional two-column flow on wide rails.
import Headline from '../ui/Headline.astro';
import type { Story } from '../../lib/home-data';
export interface Props {
  items: Story[];
  columns?: 1 | 2;
  class?: string;
}
const { items, columns = 1, class: className = '' } = Astro.props;
---
<ol class:list={['mc', columns === 2 ? 'grid grid-cols-1 sm:grid-cols-2 gap-x-8' : 'block', className]}>
  {items.map((s, i) => (
    <li class="border-b border-rule">
      <a href={s.href} class="group flex items-start gap-4 py-3.5">
        <span class="text-3xl font-bold text-azure/30 tabular-nums leading-[0.85] w-8 shrink-0">{i + 1}</span>
        <Headline as="h3" size="base" text={s.title} clamp={2} class="pt-1" />
      </a>
    </li>
  ))}
</ol>
