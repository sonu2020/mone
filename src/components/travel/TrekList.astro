---
// BLOCK · TrekList — the travelogue collection, for a desk page.
//
// One card per trek: the picture, where it is, and the two numbers that decide
// whether you can do it — distance and summit height.
import { treks, totalKm, highestPoint } from '../../lib/travelogue';

export interface Props {
  label?: string;
  class?: string;
}
const { label = 'Treks', class: className = '' } = Astro.props;
---

<section class:list={['mc', className]}>
  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-8">
    {treks.map((trek) => (
      <li>
        <a href={`/travel/${trek.slug}`} class="group block">
          <div class="relative aspect-[5/3] overflow-hidden bg-bg-page">
            <img
              src={trek.heroImage}
              alt=""
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            />
            <span class="absolute left-2 top-2 inline-flex items-center gap-1.5 bg-nav-bg/90 px-2 py-1 text-white">
              <i class="ti ti-mountain text-xs" aria-hidden="true"></i>
              <span class="eyebrow text-[0.5625rem]">{trek.state}</span>
            </span>
          </div>

          <h3 class="mt-3 font-malayalam text-[1.1875rem] [font-variation-settings:'wght'_600] text-text-primary dark:text-ivory group-hover:text-azure dark:group-hover:text-azure-light transition-colors">
            {trek.titleML}
          </h3>
          <p class="mt-0.5 caption-text text-text-muted dark:text-ivory/45">
            {trek.title} · {trek.district}
          </p>
          <p class="mt-2 font-malayalam text-[0.9375rem] leading-[1.7] text-text-secondary dark:text-ivory/65 line-clamp-2">
            {trek.cardML}
          </p>

          <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 pt-3 border-t border-rule dark:border-ivory/10">
            <div>
              <dt class="eyebrow text-text-muted dark:text-ivory/40">Distance</dt>
              <dd class="article-title tabular-nums text-text-primary dark:text-ivory">{totalKm(trek)} km</dd>
            </div>
            <div>
              <dt class="eyebrow text-text-muted dark:text-ivory/40">Summit</dt>
              <dd class="article-title tabular-nums text-text-primary dark:text-ivory">{highestPoint(trek)} m</dd>
            </div>
          </dl>
        </a>
      </li>
    ))}
  </ul>
</section>
