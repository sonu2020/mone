---

<Layout title="MediaOne Online | മലയാളം വാർത്തകൾ" description="The most authoritative source for news in Malayalam. Real-time updates from MediaOne.">
  <Header isBreaking={false} />

  <main class="flex-1 bg-bg-page py-6">
    <div class="w-full max-w-site mx-auto bg-bg-card p-4 sm:p-6 lg:p-8 border-x border-rule dark:border-ivory/10">

      <!-- Editorial Section Header -->
      <div class="border-b border-rule dark:border-ivory/10 pb-4 mb-6 flex items-center justify-between">
        <div class="flex items-baseline gap-3">
          <h1 class="section-header font-bold text-ink dark:text-ivory uppercase">
            പ്രധാന വാർത്തകൾ
          </h1>
          <span class="eyebrow text-azure dark:text-azure-light">Top Stories</span>
        </div>
        <span class="caption-text text-text-muted dark:text-ivory/40 tabular-nums">
          MediaOne Live Feed
        </span>
      </div>

      <!-- 3-Column Grid matching reference layout exactly -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        
        <!-- LEFT COLUMN: ~3 cols (lg:col-span-3) -->
        <!-- Stack of 2 stories with media on top -->
        <div class="lg:col-span-3 flex flex-col gap-6 lg:border-r lg:border-rule lg:dark:border-ivory/10 lg:pr-6">
          
          <!-- Left Story 1 -->
          <a href={leftStories[0].href} class="group block border-b border-rule dark:border-ivory/10 pb-6 lg:border-b-0 lg:pb-0">
            <Media src={leftStories[0].src} ratio="4/3" class="mb-3" zoom />
            <Kicker text={leftStories[0].category} class="mb-1.5 block" />
            <Headline as="h3" size="base" text={leftStories[0].title} class="mb-2" />
            <p class="body-small text-text-secondary dark:text-ivory/70 line-clamp-3 mb-2">
              {leftStories[0].excerpt}
            </p>
            <p class="caption-text text-text-muted dark:text-ivory/40 tabular-nums">
              {leftStories[0].date}
            </p>
          </a>

          <!-- Horizontal rule separator on desktop -->
          <div class="hidden lg:block border-t border-rule dark:border-ivory/10"></div>

          <!-- Left Story 2 -->
          <a href={leftStories[1].href} class="group block">
            <Media src={leftStories[1].src} ratio="4/3" class="mb-3" zoom />
            <Kicker text={leftStories[1].category} class="mb-1.5 block" />
            <Headline as="h3" size="base" text={leftStories[1].title} class="mb-2" />
            <p class="body-small text-text-secondary dark:text-ivory/70 line-clamp-3 mb-2">
              {leftStories[1].excerpt}
            </p>
            <p class="caption-text text-text-muted dark:text-ivory/40 tabular-nums">
              {leftStories[1].date}
            </p>
          </a>

        </div>

        <!-- CENTER COLUMN: ~6 cols (lg:col-span-6) -->
        <!-- Prominent Hero Story with 16:9 media & lead text -->
        <div class="lg:col-span-6 flex flex-col lg:border-r lg:border-rule lg:dark:border-ivory/10 lg:px-2 border-b border-rule dark:border-ivory/10 pb-6 lg:border-b-0 lg:pb-0">
          <a href={centerHeroStory.href} class="group block">
            <Media src={centerHeroStory.src} ratio="16/9" class="w-full mb-4" zoom />
            
            <Headline as="h2" size="lg" text={centerHeroStory.title} class="mb-3" />
            
            <p class="lead-text text-text-secondary dark:text-ivory/70 mb-4">
              {centerHeroStory.excerpt}
            </p>
            
            <div class="flex items-center gap-2 caption-text text-text-muted dark:text-ivory/40 tabular-nums">
              <span>{centerHeroStory.date}</span>
              <span>|</span>
              <Kicker text={centerHeroStory.category} tone="azure" />
            </div>
          </a>
        </div>

        <!-- RIGHT COLUMN: ~3 cols (lg:col-span-3) -->
        <!-- Vertical stack of text-only stories separated by hairline dividers -->
        <div class="lg:col-span-3 flex flex-col divide-y divide-rule dark:divide-ivory/10 lg:pl-2">
          {rightStories.map((story, index) => (
            <div class:list={[index === 0 ? 'pb-5' : 'py-5']}>
              <a href={story.href} class="group block">
                <Headline as="h3" size="base" text={story.title} clamp={3} class="mb-2" />
                <p class="body-small text-text-secondary dark:text-ivory/70 line-clamp-3 mb-2.5">
                  {story.excerpt}
                </p>
                <div class="flex items-center gap-2 caption-text text-text-muted dark:text-ivory/40 tabular-nums">
                  <span>{story.date}</span>
                  <span>|</span>
                  <Kicker text={story.category} tone="azure" />
                </div>
              </a>
            </div>
          ))}
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
