---
// ── /<section>/page/N · desk pages 2+ ────────────────────────────────────────
// Generated for ported desks only — a desk still on the legacy layout has no
// pagination to serve. Page 1 stays at the bare /<section>, which keeps the
// desk's canonical URL clean.
//
// Under /<section>/page/ rather than /<section>/N so paginated URLs can't
// collide with the story URLs a desk publishes at /<section>/<slug>.
//
// Not indexed: each is a slice of one list, and /<section> is the URL worth
// ranking. rel=prev/next on the controls still ties the set together.
import Layout from '../../../layouts/Layout.astro';
import HeaderBar from '../../../components/nav/HeaderBar.astro';
import SectionSubNav from '../../../components/nav/SectionSubNav.astro';
import Footer from '../../../components/Footer.astro';
import VideoModal from '../../../components/VideoModal.astro';
import ScheduleList from '../../../components/live/ScheduleList.astro';
import DeskPage from '../../../components/desk/DeskPage.astro';

import { getDesk, getDeskPage, pageCountFor, portedDeskIds } from '../../../lib/desk';
import { latest } from '../../../lib/home4-data';
import { allVideos } from '../../../lib/videos';
import { todaysVideos } from '../../../lib/videos';
import { toModalVideos, modalShows, type ModalVideo } from '../../../lib/video-modal';
import { LIVE_CHANNEL } from '../../../lib/live-tv';

export async function getStaticPaths() {
  return portedDeskIds().flatMap((id) => {
    const count = pageCountFor(getDesk(id));
    // Page 1 is served by /<section>, so start at 2.
    return Array.from({ length: Math.max(count - 1, 0) }, (_, i) => ({
      params: { section: id, n: String(i + 2) },
    }));
  });
}

const { section, n } = Astro.params;
const desk = getDesk(section!);
const page = getDeskPage(desk, Number(n));

// The modal doubles as a video browser, so it needs more than a queue.
const modalToday = todaysVideos().map((v) => ({
  id: v.slug,
  title: v.title,
  time: v.publishTime,
  poster: v.thumbnailUrl || '',
}));
const shows = await modalShows(section!);

const liveModalVideo: ModalVideo = {
  id: LIVE_CHANNEL.id,
  title: `${LIVE_CHANNEL.titleML} | ${LIVE_CHANNEL.title}`,
  category: 'Live TV',
  meta: 'Streaming now · 24×7',
  poster: LIVE_CHANNEL.poster,
  src: '',
  embedUrl: LIVE_CHANNEL.embedUrl,
  isLive: true,
};
---

<Layout
  title={`${desk.labelML} | ${desk.label} — Page ${page.page} — MediaOne`}
  description={desk.description}
  adTone="gray"
  noindex
>
  <HeaderBar isBreaking={false} showTopics={false} liveUnit />
  <SectionSubNav pathname={`/${desk.id}`} />

  <main class="flex-1 bg-bg-page">
    <DeskPage desk={desk} page={page} videos={allVideos.slice(0, 5)} trending={latest.slice(0, 5)} latest={latest.slice(5, 11)} />
  </main>

  <Footer />

  <VideoModal videos={[liveModalVideo, ...toModalVideos(allVideos)]} today={modalToday} programs={shows}>
    <ScheduleList slot="live-panel" tone="dark" />
  </VideoModal>
</Layout>
