---
// ── /<section> · every desk ──────────────────────────────────────────────────
// One route for all of them, routing between two layouts:
//
//   ported  → DeskPage       the standard desk (src/lib/desk.ts), with the
//                            homepage's type and cards, a Videos/Trending rail
//                            and a paginated Latest list
//   not yet → LegacyDeskPage the design every desk used before
//
// Porting a desk is one line: add its id to PORTED_DESKS in src/lib/desk.ts.
// The layouts differ enough at the shell (different header, different chrome)
// that the branch lives here rather than inside a component.
//
// The legacy design stays reachable for every desk at /old-section/<id>.
import Layout from "../layouts/Layout.astro";
import OldHeader from "../components/OldHeader.astro";
import HeaderBar from "../components/nav/HeaderBar.astro";
import SectionSubNav from "../components/nav/SectionSubNav.astro";
import Footer from "../components/Footer.astro";
import VideoModal from "../components/VideoModal.astro";
import SignupModal from "../components/SignupModal.astro";
import ScheduleList from "../components/live/ScheduleList.astro";
import DeskPage from "../components/desk/DeskPage.astro";
import TrekList from "../components/travel/TrekList.astro";
import BandHeading from "../components/home4/BandHeading.astro";
import LegacyDeskPage from "../components/desk/LegacyDeskPage.astro";

import { sections } from "../lib/sections";
import { getDesk, getDeskPage, isPorted, isBespoke } from "../lib/desk";
import { latest } from "../lib/home4-data";
import { allVideos } from "../lib/videos";
import { todaysVideos } from "../lib/videos";
import { toModalVideos, modalShows, type ModalVideo } from "../lib/video-modal";
import { LIVE_CHANNEL } from "../lib/live-tv";

export async function getStaticPaths() {
  return sections
    .filter((s) => !isBespoke(s.id))
    .map((s) => ({ params: { section: s.id }, props: { section: s } }));
}

const { section } = Astro.props;
const ported = isPorted(section.id);

// Only the standard layout needs the desk model and the live player.
const desk = ported ? getDesk(section.id) : null;
const page = desk ? getDeskPage(desk, 1) : null;

// The modal doubles as a video browser, so it needs more than a queue.
const modalToday = todaysVideos().map((v) => ({
  id: v.slug,
  title: v.title,
  time: v.publishTime,
  poster: v.thumbnailUrl || "",
}));
// Every desk channel joins the modal's Library, this desk's own first. That is
// also what puts the band's videos in the modal's payload — VideoModal folds in
// every episode of every entry it is handed, so the band's cards become
// playable by the same mechanism rather than a second one.
const shows = await modalShows(section.id);

const liveModalVideo: ModalVideo = {
  id: LIVE_CHANNEL.id,
  title: `${LIVE_CHANNEL.titleML} | ${LIVE_CHANNEL.title}`,
  category: "Live TV",
  meta: "Streaming now · 24×7",
  poster: LIVE_CHANNEL.poster,
  src: "",
  embedUrl: LIVE_CHANNEL.embedUrl,
  isLive: true,
};
---

<Layout
  title={`${section.nameML} | ${section.name} — MediaOne`}
  description={section.description}
  adTone="gray"
>
  {
    ported ? (
      <>
        <HeaderBar isBreaking={false} showTopics={false} liveUnit />
        <SectionSubNav pathname={`/${section.id}`} />

        <main class="flex-1 bg-bg-page">
          <DeskPage
            desk={desk!}
            page={page!}
            videos={allVideos.slice(0, 5)}
            trending={latest.slice(0, 5)}
            latest={latest.slice(5, 11)}
          >
            {section.id === "travel" && (
              <Fragment slot="collection">
                <BandHeading
                  label="Travelogues"
                  href="/travel"
                  viewAllHref="/travel"
                  class="mb-5"
                />
                <TrekList />
              </Fragment>
            )}
          </DeskPage>
        </main>

        <Footer />

        <VideoModal
          videos={[liveModalVideo, ...toModalVideos(allVideos)]}
          today={modalToday}
          programs={shows}
        >
          <ScheduleList slot="live-panel" tone="dark" />
        </VideoModal>
        <SignupModal />
      </>
    ) : (
      <>
        <OldHeader />
        <SectionSubNav pathname={`/${section.id}`} />
        <LegacyDeskPage section={section} />
        <Footer />
      </>
    )
  }
</Layout>
