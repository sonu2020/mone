---
// DESIGN · Split — draws a column split to scale on the real 12-column grid, so
// a reader can see 5 / 4 / 3 rather than parse it. Each cell is an actual grid
// item spanning its own count, which means the diagram cannot drift from the
// arithmetic: if the spans don't total 12, it shows.
export interface Props {
  cols: number[];
  label?: string;
}
const { cols, label } = Astro.props;

const total = cols.reduce((a, b) => a + b, 0);
// Tailwind needs whole class names at build time — no interpolation.
const SPAN: Record<number, string> = {
  1: 'col-span-1', 2: 'col-span-2', 3: 'col-span-3', 4: 'col-span-4',
  5: 'col-span-5', 6: 'col-span-6', 7: 'col-span-7', 8: 'col-span-8',
  9: 'col-span-9', 10: 'col-span-10', 11: 'col-span-11', 12: 'col-span-12',
};
---

<div class="mc">
  <div class="grid grid-cols-12 gap-1.5">
    {cols.map((c) => (
      <div
        class:list={[
          SPAN[c],
          'h-9 grid place-items-center rounded-xs bg-azure/10 border border-azure/30 caption-text tabular-nums font-semibold text-azure dark:text-azure-light',
        ]}
      >{c}</div>
    ))}
  </div>
  {label && (
    <p class="mt-1.5 caption-text text-text-muted dark:text-ivory/45">
      {label}
      {total !== 12 && (
        <span class="text-accent-red"> · spans total {total}, not 12</span>
      )}
    </p>
  )}
</div>
