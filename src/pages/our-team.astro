---
import Layout from '../layouts/Layout.astro';
import Header from '../components/nav/HeaderBar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Our Team — MediaOne" description="The editorial and leadership team behind MediaOne">
  <Header />

  <main class="flex-1 bg-bg-page">
    <div class="w-full max-w-site mx-auto px-4 sm:px-6 md:px-8 py-10">
      <nav class="flex items-center gap-2 meta-text text-text-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-azure transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-azure">Our Team</span>
      </nav>

      <h1 class="text-hero font-bold text-text-primary text-balance">Our Team</h1>

      <div class="mt-8 max-w-prose space-y-5 text-body text-text-primary">
        <p>
          MediaOne's strength lies in its people — journalists, producers, editors, and technologists who are passionate about truth and public service.
        </p>
        <p>
          Our editorial leadership brings decades of experience in television, digital media, and investigative journalism. From the newsroom to the field, every team member is guided by a commitment to accuracy, fairness, and the highest standards of journalism.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
