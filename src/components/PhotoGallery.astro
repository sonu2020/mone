---
import DummyImage from './DummyImage.astro';

export interface Props {
  items?: { alt?: string }[];
  title?: string;
  class?: string;
}

const {
  items = [{ alt: 'Gallery 1' }, { alt: 'Gallery 2' }, { alt: 'Gallery 3' }, { alt: 'Gallery 4' }, { alt: 'Gallery 5' }],
  title,
  class: className = '',
} = Astro.props;
---

<div class:list={['mc', className]}>
  {title && <h3 class="eyebrow text-ink-muted mb-4">{title}</h3>}
  <div class="flex gap-4 overflow-x-auto scrollbar-none pb-2 sm:gap-5 md:hidden">
    {items.map((img, i) => (
      <div class="shrink-0 w-24 sm:w-28">
        <DummyImage class="w-24 h-32 sm:w-28 sm:h-36 rounded-md" w={112} h={144} seed={`gal-m${i}`} />
      </div>
    ))}
  </div>
  <div class="hidden md:grid md:grid-cols-5 md:gap-4 lg:gap-5">
    {items.map((img, i) => (
      <div class="aspect-[3/4] overflow-hidden rounded-md">
        <DummyImage class="w-full h-full" w={240} h={320} seed={`gal-d${i}`} />
      </div>
    ))}
  </div>
</div>
