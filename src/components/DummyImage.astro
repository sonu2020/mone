---
export interface Props {
  class?: string;
  seed?: string;
  w?: number;
  h?: number;
  src?: string;
  /** `eager` + fetchpriority `high` for above-the-fold LCP art; lazy otherwise. */
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  class: className = '',
  seed,
  w = 800,
  h = 450,
  src: customSrc,
  loading = 'lazy',
  fetchpriority = 'auto',
