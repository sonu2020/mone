---
// BLUEPRINT · BandBlueprint — one band, drawn on the real 12-column grid.
//
// Cells are actual grid items spanning their stated counts, so the drawing is
// laid out by the same engine as the band it documents. A split that doesn't
// total 12 comes out visibly short rather than quietly wrong.
import SkCell from './SkCell.astro';
import type { Cell } from './types';

export interface Props {
  cells: Cell[];
  /** Full-bleed bands ignore the 12-column grid and run edge to edge. */
  bleed?: boolean;
  class?: string;
}
const { cells, bleed = false, class: className = '' } = Astro.props;

// Tailwind needs whole class names at build time — no interpolation.
const SPAN: Record<number, string> = {
  1: 'lg:col-span-1', 2: 'lg:col-span-2', 3: 'lg:col-span-3', 4: 'lg:col-span-4',
  5: 'lg:col-span-5', 6: 'lg:col-span-6', 7: 'lg:col-span-7', 8: 'lg:col-span-8',
  9: 'lg:col-span-9', 10: 'lg:col-span-10', 11: 'lg:col-span-11', 12: 'lg:col-span-12',
};
---

{bleed ? (
  <div class:list={['mc', 'min-w-0', className]}>
    <SkCell kind={cells[0].kind} label={cells[0].label} />
  </div>
) : (
  <div class:list={['mc', 'grid grid-cols-1 gap-4 lg:grid-cols-12 lg:gap-4', className]}>
    {cells.map((cell, i) => (
      <SkCell
        kind={cell.kind}
        label={cell.label}
        rule={i < cells.length - 1}
        class={SPAN[cell.span]}
      />
    ))}
  </div>
)}
