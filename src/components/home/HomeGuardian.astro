---
// ── Pillars (Guardian homage) ──────────────────────────────────────────────
// Bold container blocks, each capped by a thick accent top-border and a loud
// section label. Heavy headline weights, image-forward cards, roomy gutters.
import DummyImage from '../DummyImage.astro';
import { hero, topStories, latest, cluster } from '../../lib/home-data';

const kerala = cluster('kerala');
const sports = cluster('sports');
const ent = cluster('entertainment');
const spotlight = [latest[0], latest[1], latest[3], kerala.items[0]];
---

<div class:list={['mc', 'bg-bg-page']}>
  <div class="w-full max-w-site mx-auto px-3 sm:px-5 lg:px-6 py-5 lg:py-7 space-y-7 lg:space-y-9">

    <!-- Lead pillar -->
    <section class="bg-bg-card border-t-4 border-azure">
      <div class="px-4 sm:px-6 lg:px-7 pt-3 pb-1">
        <a href={kerala.href} class="inline-flex items-baseline gap-2 group">
          <span class="section-header text-ink group-hover:text-azure transition-colors">{kerala.name}</span>
          <span class="eyebrow text-text-muted">{kerala.nameEn}</span>
        </a>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3">
        <!-- Hero, headline below image, heavy weight -->
        <a href={hero.href} class="group block lg:col-span-2 lg:border-r border-rule p-4 sm:p-6 lg:p-7">
          <div class="relative aspect-[16/9] overflow-hidden mb-4">
            <DummyImage class="w-full h-full" w={1280} h={720} seed="grd-lead" />
          </div>
          <p class="eyebrow text-azure mb-2">{hero.category}</p>
          <h1 class="hero-text font-extrabold text-ink group-hover:text-azure transition-colors text-balance leading-[1.05]">{hero.title}</h1>
          <p class="mt-3 lead-text text-text-secondary max-w-prose">{hero.excerpt}</p>
        </a>
        <!-- Bold headline list -->
        <div class="divide-y divide-rule">
          {topStories.map((s, i) => (
            <a href={s.href} class="group block p-4 sm:p-5 lg:px-7">
              <p class="eyebrow text-azure mb-1.5">{s.category}</p>
              <h3 class:list={[i === 0 ? 'article-title-lg' : 'article-title', 'font-bold text-text-primary group-hover:text-azure transition-colors leading-snug']}>{s.title}</h3>
              <p class="mt-1.5 caption-text text-text-muted tabular-nums">{s.date}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Spotlight pillar: 4 image cards -->
    <section class="bg-bg-card border-t-4 border-ink">
      <div class="px-4 sm:px-6 lg:px-7 pt-3 pb-4">
        <h2 class="section-header text-ink">സ്പോട്ലൈറ്റ്</h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-y lg:divide-y-0 divide-rule border-t border-rule">
        {spotlight.map((s) => (
          <a href={s.href} class="group block p-4 sm:p-5 lg:p-6 hover:bg-bg-page/60 transition-colors">
            <div class="relative aspect-[16/10] overflow-hidden mb-3">
              <DummyImage class="w-full h-full" w={520} h={325} seed={s.href + 'g'} />
            </div>
            {s.category && <p class="eyebrow text-azure mb-1.5">{s.category}</p>}
            <h3 class="article-title font-bold text-text-primary group-hover:text-azure transition-colors leading-snug">{s.title}</h3>
            {s.date && <p class="mt-2 caption-text text-text-muted tabular-nums">{s.date}</p>}
          </a>
        ))}
      </div>
    </section>

    <!-- Opinion pillar: tinted panel, quote-led -->
    <section class="bg-ink text-ivory border-t-4 border-azure">
      <div class="px-4 sm:px-6 lg:px-7 py-5 lg:py-6">
        <h2 class="eyebrow text-azure-light mb-5">അഭിപ്രായം</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-7">
          {ent.items.slice(0, 3).map((s) => (
            <a href={s.href} class="group block lg:border-l border-ivory/15 lg:pl-6 first:border-0 first:pl-0">
              <span class="block text-azure-light text-4xl leading-none mb-1 font-serif">“</span>
              <h3 class="article-title-lg font-semibold text-ivory group-hover:text-azure-light transition-colors leading-snug">{s.title}</h3>
              <p class="mt-3 eyebrow text-ivory/50">{ent.name}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Two split pillars -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-7 lg:gap-9">
      {[sports, kerala].map((sec) => (
        <section class="bg-bg-card border-t-4 border-azure">
          <div class="flex items-baseline justify-between px-4 sm:px-6 lg:px-7 pt-3 pb-3">
            <h2 class="section-header text-ink">{sec.name}</h2>
            <a href={sec.href} class="eyebrow text-azure hover:text-azure-dark transition-colors">View all →</a>
          </div>
          <a href={sec.lead.href} class="group block border-t border-rule p-4 sm:p-6 lg:p-7">
            <div class="relative aspect-[16/9] overflow-hidden mb-3">
              <DummyImage class="w-full h-full" w={960} h={540} seed={sec.id + '-glead'} />
            </div>
            <h3 class="article-title-lg font-bold text-text-primary group-hover:text-azure transition-colors leading-snug">{sec.lead.title}</h3>
          </a>
          <div class="divide-y divide-rule border-t border-rule">
            {sec.items.slice(0, 3).map((s) => (
              <a href={s.href} class="group block px-4 sm:px-6 lg:px-7 py-3.5">
                <h3 class="article-title font-semibold text-text-primary group-hover:text-azure transition-colors leading-snug">{s.title}</h3>
                <p class="mt-1 caption-text text-text-muted tabular-nums">{s.date}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

  </div>
</div>
