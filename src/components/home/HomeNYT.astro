---
// ── Broadsheet (NYT homage) ────────────────────────────────────────────────
// Text-forward. A 3-column top package split by vertical hairlines, the lead
// set headline-first with the image below (never an overlay). Section rows are
// rule-divided, image-light. Restraint, generous whitespace, no cards/rounding.
import DummyImage from '../DummyImage.astro';
import { hero, topStories, latest, mostRead, cluster } from '../../lib/home-data';

const kerala = cluster('kerala');
const india = cluster('india');
const moreNews = [...kerala.items.slice(0, 1), ...india.items.slice(0, 1), ...latest.slice(2, 4), ...kerala.items.slice(1, 3)];
---

<div class:list={['mc', 'bg-bg-card']}>
  <div class="w-full max-w-site mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Top package: opinion rail · dominant lead · secondary rail -->
    <section class="grid grid-cols-1 lg:grid-cols-12 lg:gap-7 py-6 lg:py-8 border-b-2 border-ink">

      <!-- Left rail: opinion / brief headlines -->
      <div class="lg:col-span-3 lg:border-r border-rule lg:pr-7 order-2 lg:order-1 mt-8 lg:mt-0">
        <p class="eyebrow text-azure pb-2 mb-3 border-b border-ink">ഏറ്റവും പുതിയത്</p>
        <ul class="divide-y divide-rule">
          {topStories.map((s) => (
            <li class="py-3 first:pt-0">
              <a href={s.href} class="group block">
                <h3 class="article-title text-text-primary group-hover:text-azure transition-colors leading-snug">{s.title}</h3>
                <p class="mt-1.5 caption-text text-text-muted tabular-nums">{s.date}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Center: the lead, headline-first -->
      <article class="lg:col-span-6 lg:border-r border-rule lg:pr-7 order-1 lg:order-2">
        <a href={hero.href} class="group block">
          <p class="eyebrow text-azure mb-3">{hero.category}</p>
          <h1 class="display-text text-ink group-hover:text-azure transition-colors text-balance">{hero.title}</h1>
          <p class="mt-4 lead-text text-text-secondary max-w-prose">{hero.excerpt}</p>
          <div class="relative aspect-[16/9] overflow-hidden mt-5">
            <DummyImage class="w-full h-full" w={1280} h={720} seed="nyt-lead" />
          </div>
          <p class="mt-2 caption-text text-text-muted tabular-nums">{hero.date}</p>
        </a>
      </article>

      <!-- Right rail: stacked secondaries -->
      <div class="lg:col-span-3 order-3 mt-8 lg:mt-0 divide-y divide-rule">
        {latest.slice(0, 3).map((s, i) => (
          <a href={s.href} class="group block py-4 first:pt-0">
            {i === 0 && (
              <div class="relative aspect-[16/9] overflow-hidden mb-3">
                <DummyImage class="w-full h-full" w={640} h={360} seed={`nyt-r${i}`} />
              </div>
            )}
            <p class="eyebrow text-azure mb-1.5">{s.category}</p>
            <h3 class:list={[i === 0 ? 'article-title-lg' : 'article-title', 'text-text-primary group-hover:text-azure transition-colors leading-snug']}>{s.title}</h3>
            <p class="mt-1.5 caption-text text-text-muted tabular-nums">{s.date}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- More in news: 4-up text grid, rule-topped -->
    <section class="py-7 lg:py-9 border-b border-rule">
      <h2 class="eyebrow text-text-muted mb-5">കൂടുതൽ വാർത്തകൾ</h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-7 gap-y-7">
        {moreNews.map((s) => (
          <a href={s.href} class="group block border-t-2 border-ink pt-3">
            <div class="relative aspect-[16/10] overflow-hidden mb-3">
              <DummyImage class="w-full h-full" w={520} h={325} seed={s.href} />
            </div>
            <h3 class="article-title text-text-primary group-hover:text-azure transition-colors leading-snug">{s.title}</h3>
            {s.date && <p class="mt-1.5 caption-text text-text-muted tabular-nums">{s.date}</p>}
          </a>
        ))}
      </div>
    </section>

    <!-- Two-column section package + most-read box -->
    <section class="grid grid-cols-1 lg:grid-cols-12 lg:gap-7 py-7 lg:py-9">
      <!-- Kerala column -->
      <div class="lg:col-span-8 lg:border-r border-rule lg:pr-7">
        <div class="flex items-baseline justify-between border-b-2 border-ink pb-2 mb-5">
          <h2 class="section-header text-ink">{kerala.name}</h2>
          <a href={kerala.href} class="eyebrow text-azure hover:text-azure-dark transition-colors">View all →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
          <a href={kerala.lead.href} class="group block sm:row-span-2">
            <div class="relative aspect-[4/3] overflow-hidden mb-3">
              <DummyImage class="w-full h-full" w={720} h={540} seed="nyt-kerala" />
            </div>
            <h3 class="article-title-lg text-text-primary group-hover:text-azure transition-colors">{kerala.lead.title}</h3>
            <p class="mt-2 body-small text-text-secondary line-clamp-3">{kerala.lead.excerpt}</p>
          </a>
          <div class="divide-y divide-rule">
            {kerala.items.slice(0, 4).map((s) => (
              <a href={s.href} class="group block py-3 first:pt-0">
                <h3 class="article-title text-text-primary group-hover:text-azure transition-colors leading-snug">{s.title}</h3>
                <p class="mt-1 caption-text text-text-muted tabular-nums">{s.date}</p>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Most read, boxed numbered list -->
      <aside class="lg:col-span-4 mt-8 lg:mt-0">
        <h2 class="section-header text-ink border-b-2 border-ink pb-2 mb-1">ഏറ്റവും വായിച്ചത്</h2>
        <ol class="divide-y divide-rule">
          {mostRead.map((s, i) => (
            <li class="py-3.5">
              <a href={s.href} class="group flex gap-4">
                <span class="font-serif text-3xl font-light text-azure/40 tabular-nums leading-none pt-0.5 w-7 shrink-0">{i + 1}</span>
                <h3 class="article-title text-text-primary group-hover:text-azure transition-colors leading-snug">{s.title}</h3>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    </section>

  </div>
</div>
