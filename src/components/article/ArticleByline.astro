---
// BLOCK · ArticleByline — who wrote it, when it went live, when it was revised,
// and how long it takes to read. `layout="row"` is the wireframe's single line
// with share on the right; `layout="stack"` is the labelled block used where
// the opener has more room — name and all three labelled pairs on one wrapping
// line, so the labels survive without costing three rows of height.
import ShareBar from './ShareBar.astro';

export interface Props {
  author: { name: string; role?: string };
  published: string;
  updated?: string;
  readingTime: number;
  layout?: 'row' | 'stack';
  tone?: 'default' | 'onDark';
  class?: string;
}
const {
  author,
  published,
  updated,
  readingTime,
  layout = 'row',
  tone = 'default',
  class: className = '',
} = Astro.props;

const onDark = tone === 'onDark';
const initials = author.name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();

const nameCls = onDark ? 'text-white' : 'text-text-primary';
const metaCls = onDark ? 'text-white/60' : 'text-text-muted';
const ruleCls = onDark ? 'border-white/20' : 'border-rule dark:border-ivory/10';
const valueCls = `meta-text tabular-nums ${onDark ? 'text-white/80' : 'text-text-secondary'}`;
---
<div class:list={['mc', layout === 'row' ? 'py-4' : 'py-2.5', 'border-y', ruleCls, className]}>
  <div class:list={[
    'flex',
    layout === 'row' ? 'items-center gap-3.5' : 'items-center gap-2.5',
  ]}>
    <span
      class:list={[
        'shrink-0 rounded-full grid place-items-center font-bold',
        layout === 'row' ? 'size-11 meta-text' : 'size-7 caption-text',
        onDark ? 'bg-white/15 text-white' : 'bg-ivory-dark dark:bg-brand-elevated text-azure dark:text-azure-light',
      ]}
      aria-hidden="true"
    >{initials}</span>

    {layout === 'row' ? (
      <div class="min-w-0 flex-1">
        <p class:list={['article-title', nameCls]}>{author.name}</p>
        <p class:list={['caption-text tabular-nums', metaCls]}>
          {updated ? 'Updated' : 'Published'} {updated ?? published} · {readingTime} min read
        </p>
      </div>
    ) : (
      <div class="min-w-0 flex-1 flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
        <p class:list={['meta-text font-semibold', nameCls]}>{author.name}</p>

        <dl class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
          {published && (
            <>
              <dt class:list={['eyebrow', metaCls]}>Published</dt>
              <dd class:list={[valueCls]}>{published}</dd>
            </>
          )}

          {updated && (
            <>
              <dt class:list={['eyebrow', metaCls]}>Updated</dt>
              <dd class:list={[valueCls]}>{updated}</dd>
            </>
          )}

          <dt class:list={['eyebrow', metaCls]}>Read</dt>
          <dd class:list={[valueCls]}>{readingTime} min</dd>
        </dl>
      </div>
    )}

    {layout === 'row' && <ShareBar tone={tone} class="hidden sm:flex shrink-0" />}
  </div>

  {layout === 'row' && <ShareBar tone={tone} class="sm:hidden mt-3" />}
</div>
