---
// BLOCK · Timeline — a live update feed. Timestamped spine of headlines.
// `ring` should match the surface the timeline sits on (default bg-card).
import Headline from '../ui/Headline.astro';
import type { Story } from '../../lib/home-data';
export interface TimelineItem extends Story { time: string; }
export interface Props {
  items: TimelineItem[];
  ring?: string;   // tailwind colour utility matching the surface, e.g. 'ring-bg-card'
  accent?: 'azure' | 'red';
  class?: string;
}
const { items, ring = 'ring-bg-card', accent = 'azure', class: className = '' } = Astro.props;
const node = accent === 'red' ? 'bg-accent-red' : 'bg-azure';
const time = accent === 'red' ? 'text-accent-red' : 'text-azure';
---
<ol class:list={['mc', 'relative', className]}>
  {items.map((s, i) => (
    <li class="relative pl-6 pb-5 last:pb-0">
      {i < items.length - 1 && <span class="absolute left-[3px] top-2 bottom-0 w-px bg-rule"></span>}
      <span class:list={['absolute left-0 top-1.5 size-[7px] rounded-full ring-2', node, ring]}></span>
      <a href={s.href} class="group block">
        <time class:list={['caption-text font-bold tabular-nums', time]}>{s.time}</time>
        <Headline as="p" size="md" text={s.title} clamp={2} class="mt-0.5" />
      </a>
    </li>
  ))}
</ol>
