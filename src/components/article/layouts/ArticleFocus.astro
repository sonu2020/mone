---
// LAYOUT · Focus — the reading case.
//
// One centred measure, no rails beside the prose, and the inline ad blocks
// filtered out (`adDensity="light"`). Everything the classic layout parks
// alongside the story — sponsor, video, next reads — is deferred until the
// story is finished, so the column the eye tracks down is only ever the story.
// A thin progress bar at the top replaces the furniture as the sense of place.
import ArticleBreadcrumb from '../ArticleBreadcrumb.astro';
import ArticleHeadline from '../ArticleHeadline.astro';
import ArticleByline from '../ArticleByline.astro';
import ArticleBody from '../ArticleBody.astro';
import ShareBar from '../ShareBar.astro';
import TopicChips from '../TopicChips.astro';
import SponsoredCard from '../SponsoredCard.astro';
import ReadMoreList from '../ReadMoreList.astro';
import VideoBlock from '../VideoBlock.astro';
import AdDisclaimer from '../AdDisclaimer.astro';
import AdSlot from '../../AdSlot.astro';
import Media from '../../ui/Media.astro';
import { readingTime, type ArticleDoc } from '../../../lib/article-data';

export interface Props { doc: ArticleDoc }
const { doc } = Astro.props;
const minutes = readingTime(doc);
---
<div class="mc bg-bg-card">
  <div
    id="read-progress"
    class="fixed inset-x-0 top-0 z-50 h-0.5 bg-azure origin-left scale-x-0"
    aria-hidden="true"
  ></div>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 pt-10 lg:pt-14">
    <ArticleBreadcrumb section={doc.section} sectionHref={doc.sectionHref} />
    <ArticleHeadline
      kicker={doc.section}
      badge={doc.badge}
      title={doc.title}
      dek={doc.dek}
      class="mt-5"
    />
    <ArticleByline
      author={doc.author}
      published={doc.published}
      updated={doc.updated}
      readingTime={minutes}
      layout="stack"
      class="mt-7"
    />

    <figure class="mt-8">
      <Media src={doc.image} ratio="16/9" class="w-full" loading="eager" fetchpriority="high" />
      <figcaption class="pt-2 caption-text text-text-muted">{doc.caption}</figcaption>
    </figure>

    <ArticleBody blocks={doc.blocks} adDensity="light" class="mt-9" />

    <div class="mt-10 pt-6 border-t border-rule dark:border-ivory/10 flex flex-wrap items-center justify-between gap-4">
      <TopicChips topics={doc.tags} />
      <ShareBar />
    </div>
  </article>

  <!-- Everything the rails would have carried, after the story rather than beside it -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 mt-14 space-y-12">
    <SponsoredCard item={doc.sponsored} />
    <VideoBlock title={doc.video.title} src={doc.video.image} duration={doc.video.duration} />
    <AdSlot slot="story-end" format="leaderboard" tone="gray" lazy={true} />
  </div>

  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">
    <ReadMoreList
      items={doc.readMore}
      title="Read More"
      variant="grid"
      limit={4}
      class="mt-14 pt-10 border-t border-rule dark:border-ivory/10"
    />
    <AdDisclaimer text={doc.disclaimer} class="mt-14 pb-14" />
  </div>
</div>

<script is:inline>
  (function () {
    var bar = document.getElementById('read-progress');
    var article = document.querySelector('article');
    if (!bar || !article) return;
    var ticking = false;
    function update() {
      var rect = article.getBoundingClientRect();
      var total = rect.height - window.innerHeight;
      var progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      bar.style.transform = 'scaleX(' + progress + ')';
      ticking = false;
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  })();
</script>
