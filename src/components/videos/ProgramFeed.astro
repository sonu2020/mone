---
// BLOCK · ProgramFeed — featured videos from the shows, as a list.
//
// This replaced a switcher: tabs across the top, and a two-level drill into one
// show's run. It browsed well and answered badly — a panel beside a video grid
// is asked "what should I watch", and the switcher's response was to present a
// control. So the tabs and the drill-down are gone and what is left is the
// answer: things worth watching, each naming the show it came from.
//
// Nothing here has state. Every row is a `data-video-open` trigger, so the only
// action is play, and it opens the shared player over the page rather than
// navigating out of the grid the reader was scanning.
//
// Used by /videos and by the homepage band, which is why it takes rows rather
// than shows — the two pages differ in how many they show and in nothing else.
import type { ProgramPick } from '../../lib/video-modal';

export interface Props {
  items: ProgramPick[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

{items.length > 0 && (
  <ul
    class:list={[
      'mc',
      'flex flex-col divide-y divide-white/10 bg-header-bg-deep border border-white/10 rounded-sm overflow-hidden',
      className,
    ]}
  >
    {items.map((item) => (
      <li>
        <button
          type="button"
          data-video-open={item.id}
          class="group w-full text-left flex items-start gap-3 p-3 hover:bg-white/[0.04] transition-colors"
        >
          <span class="relative w-[6.5rem] shrink-0 aspect-video overflow-hidden rounded-xs bg-black/50">
            <img
              src={item.poster}
              alt=""
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="absolute inset-0 grid place-items-center bg-black/35 opacity-0 group-hover:opacity-100 transition-opacity">
              <i class="ti ti-player-play text-base text-white" aria-hidden="true"></i>
            </span>
            {item.duration && (
              <span class="absolute right-1 bottom-1 bg-black/80 px-1 text-[10px] font-bold tabular-nums text-white">
                {item.duration}
              </span>
            )}
          </span>

          <span class="min-w-0 flex-1">
            <!-- The show is the point of the row: it is what the grid beside
                 this cannot tell you. -->
            <span class="block eyebrow text-azure-light">{item.programTitle}</span>
            <span class="mt-1 block font-malayalam text-[0.8125rem] leading-4 [font-variation-settings:'wdth'_95,'wght'_580] text-white group-hover:text-azure-light line-clamp-2 transition-colors">
              {item.title}
            </span>
          </span>
        </button>
      </li>
    ))}
  </ul>
)}
