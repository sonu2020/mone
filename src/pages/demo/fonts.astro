---
// ── /demo/fonts ─────────────────────────────────────────────────────────────
// Malayalam & Latin Font Switcher and Type Trial Playground.
//
// Allows live font switching between 10 Malayalam typefaces and 7 Latin typefaces,
// real-time axis controls (weight, width, slant), curated pairing presets,
// and side-by-side switching between real page layout (Kerala Desk) and specimen sheet.

import Layout from '../../layouts/Layout.astro';
import HeaderBar from '../../components/nav/HeaderBar.astro';
import Footer from '../../components/Footer.astro';
import DeskPage from '../../components/desk/DeskPage.astro';
import { getDesk, getDeskPage } from '../../lib/desk';
import { latest } from '../../lib/home4-data';
import { allVideos } from '../../lib/videos';
import '../../styles/fonts-demo.css';

const SECTION = 'kerala';
const desk = getDesk(SECTION);
const page = getDeskPage(desk, 1);

const MALAYALAM_FACES = [
  {
    id: 'malini', label: 'Malini', family: 'Malini', ml: 'MaliniML',
    by: 'Santhosh Thottingal', kind: 'Variable · 4 axes', category: 'variable',
    axes: { wght: [100, 900, 500], wdth: [75, 125, 100], slnt: [0, 12, 0] },
  },
  {
    id: 'nupuram', label: 'Nupuram', family: 'Nupuram', ml: 'NupuramML',
    by: 'Santhosh Thottingal', kind: 'Variable · 3 axes', category: 'variable',
    axes: { wght: [100, 900, 400], wdth: [75, 125, 100], slnt: [-15, 0, 0] },
  },
  {
    id: 'anek', label: 'Anek Malayalam', family: 'Anek Malayalam', ml: null,
    by: 'Ek Type', kind: 'Variable · current site', category: 'variable',
    axes: { wght: [100, 800, 500], wdth: [75, 125, 100], slnt: null },
  },
  {
    id: 'noto', label: 'Noto Sans Malayalam', family: 'Noto Sans Malayalam', ml: null,
    by: 'Google', kind: 'Variable · sans', category: 'variable',
    axes: { wght: [100, 900, 400], wdth: null, slnt: null },
  },
  {
    id: 'noto-serif', label: 'Noto Serif Malayalam', family: 'Noto Serif Malayalam', ml: null,
    by: 'Google', kind: 'Variable · serif', category: 'serif',
    axes: { wght: [100, 900, 400], wdth: null, slnt: null },
  },
  {
    id: 'gayathri', label: 'Gayathri', family: 'Gayathri', ml: null,
    by: 'SMC', kind: 'Static · display', category: 'display',
    axes: null,
  },
  {
    id: 'baloo', label: 'Baloo Chettan 2', family: 'Baloo Chettan 2', ml: null,
    by: 'Ek Type', kind: 'Variable · rounded', category: 'variable',
    axes: { wght: [400, 800, 500], wdth: null, slnt: null },
  },
  {
    id: 'manjari', label: 'Manjari', family: 'Manjari', ml: 'ManjariML',
    by: 'SMC', kind: 'Static · Regular, Bold', category: 'static',
    axes: null,
  },
  {
    id: 'rachana', label: 'Rachana', family: 'Rachana', ml: 'RachanaML',
    by: 'Hussain K H / SMC', kind: 'Static · traditional', category: 'static',
    axes: null,
  },
  {
    id: 'chilanka', label: 'Chilanka', family: 'Chilanka', ml: 'ChilankaML',
    by: 'Santhosh Thottingal', kind: 'Static · handwriting', category: 'static',
    axes: null,
  },
];

const LATIN_FACES = [
  { id: 'match', label: 'Match Malayalam', family: null, note: 'Use typeface embedded Latin' },
  { id: 'anek-latin', label: 'Anek Latin', family: 'Anek Latin', note: 'MediaOne Brand Latin' },
  { id: 'inter', label: 'Inter', family: 'Inter', note: 'Clean modern sans' },
  { id: 'outfit', label: 'Outfit', family: 'Outfit', note: 'Geometric editorial display' },
  { id: 'roboto', label: 'Roboto', family: 'Roboto', note: 'Neutral standard' },
  { id: 'lora', label: 'Lora', family: 'Lora', note: 'Editorial serif' },
  { id: 'space-grotesk', label: 'Space Grotesk', family: 'Space Grotesk', note: 'Tech sans' },
];

const PRESETS = [
  { id: 'brand', label: 'MediaOne Brand (Anek)', mal: 'anek', lat: 'anek-latin', wght: 500 },
  { id: 'noto-preset', label: 'Noto Sans Malayalam', mal: 'noto', lat: 'anek-latin', wght: 400 },
  { id: 'modern', label: 'Modern Newspaper (Malini)', mal: 'malini', lat: 'outfit', wght: 600 },
  { id: 'serif', label: 'Classical Serif (Noto Serif)', mal: 'noto-serif', lat: 'lora', wght: 400 },
  { id: 'friendly', label: 'Friendly & Soft (Baloo)', mal: 'baloo', lat: 'inter', wght: 500 },
  { id: 'literary', label: 'Literary Traditional (Rachana)', mal: 'rachana', lat: 'lora', wght: 400 },
];

const AXIS_META = [
  { id: 'wght', label: 'Weight', step: 10, suffix: '' },
  { id: 'wdth', label: 'Width', step: 1, suffix: '%' },
  { id: 'slnt', label: 'Slant', step: 1, suffix: '°' },
];
---

<Layout
  title="Font Switcher — Malayalam & Latin Type Trial"
  description="Interactive font playground for MediaOne with live switching across Malayalam and Latin typefaces, axis controls, pairing presets, and real desk rendering."
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Anek+Latin:wght@100..800&family=Anek+Malayalam:wght@100..800&family=Baloo+Chettan+2:wght@400..800&family=Gayathri:wght@100;400;700&family=Inter:wght@100..900&family=Lora:ital,wght@0,400..700;1,400..700&family=Noto+Sans+Malayalam:wght@100..900&family=Noto+Serif+Malayalam:wght@100..900&family=Outfit:wght@100..900&family=Roboto:wght@100..900&family=Space+Grotesk:wght@300..700&display=swap"
  />

  <HeaderBar isBreaking={false} showTopics={false} liveUnit />

  <header class="border-b border-rule dark:border-ivory/10 bg-bg-card">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow text-azure dark:text-azure-light">Typography Lab</p>
          <h1 class="mt-2 text-[clamp(2.25rem,6vw,4rem)] leading-[0.95] font-bold tracking-tight text-text-primary">
            Font Switcher
          </h1>
          <p class="mt-3 lead-text text-text-secondary max-w-[54ch]">
            Switch live between 10 Malayalam typefaces and 7 Latin typefaces set across MediaOne's Kerala news desk or full specimen sheet.
          </p>
        </div>

        <!-- View Mode Switcher -->
        <div class="flex border border-rule dark:border-ivory/20" role="group" aria-label="View Mode">
          <button
            type="button"
            data-view="desk"
            aria-pressed="true"
            class="px-4 py-2 text-sm font-semibold border-r border-rule dark:border-ivory/20 aria-pressed:bg-azure aria-pressed:text-ivory aria-pressed:border-azure transition-colors"
          >
            Real Desk View
          </button>
          <button
            type="button"
            data-view="specimen"
            aria-pressed="false"
            class="px-4 py-2 text-sm font-semibold aria-pressed:bg-azure aria-pressed:text-ivory aria-pressed:border-azure transition-colors"
          >
            Type Specimen
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ══ Sticky Font Controls Bar ═══════════════════════════════════════════ -->
  <div id="fonts-controls" class="sticky top-0 z-30 border-b border-rule dark:border-ivory/10 bg-bg-card/95 backdrop-blur-md shadow-sm">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-3 space-y-3">

      <!-- Row 1: Malayalam Typeface Selector -->
      <div class="flex items-start gap-3">
        <span class="eyebrow text-azure dark:text-azure-light pt-2 shrink-0">Malayalam</span>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Malayalam typeface">
          {MALAYALAM_FACES.map((f, i) => (
            <button
              type="button"
              data-face={f.id}
              data-family={f.family}
              data-ml={f.ml ?? ''}
              data-axes={JSON.stringify(f.axes)}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="px-3 py-1.5 text-left border border-rule dark:border-ivory/20 hover:border-azure aria-pressed:bg-azure aria-pressed:text-ivory aria-pressed:border-azure transition-colors"
            >
              <span class="block nav-text">{f.label}</span>
              <span class="block caption-text opacity-70">{f.kind}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Row 2: Latin Typeface Selector -->
      <div class="flex items-center gap-3 border-t border-rule/50 dark:border-ivory/10 pt-2.5">
        <span class="eyebrow text-text-muted shrink-0">Latin</span>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Latin typeface">
          {LATIN_FACES.map((l, i) => (
            <button
              type="button"
              data-latin-face={l.id}
              data-latin-family={l.family ?? ''}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="px-2.5 py-1 text-xs font-medium border border-rule dark:border-ivory/20 hover:border-azure aria-pressed:bg-azure aria-pressed:text-ivory aria-pressed:border-azure transition-colors"
              title={l.note}
            >
              {l.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Row 3: Variable Axes & Presets -->
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-rule/50 dark:border-ivory/10 pt-2.5">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {AXIS_META.map((axis) => (
            <label class="flex items-center gap-2 transition-opacity" data-axis-row={axis.id}>
              <span class="eyebrow text-text-muted whitespace-nowrap">{axis.label}</span>
              <input type="range" data-axis={axis.id} step={axis.step} class="w-24 accent-azure cursor-pointer" aria-label={`${axis.label} axis`} />
              <output data-axis-out={axis.id} class="w-10 caption-text tabular-nums text-text-primary font-mono"></output>
            </label>
          ))}

          <p data-static-note hidden class="caption-text text-text-muted">
            Static face — weight snaps to available font weights.
          </p>
        </div>

        <!-- Presets Switcher -->
        <div class="flex items-center gap-2">
          <span class="eyebrow text-text-muted whitespace-nowrap">Presets</span>
          <div class="flex flex-wrap gap-1">
            {PRESETS.map((p) => (
              <button
                type="button"
                data-preset={p.id}
                data-preset-mal={p.mal}
                data-preset-lat={p.lat}
                data-preset-wght={p.wght}
                class="px-2 py-0.5 text-xs border border-rule dark:border-ivory/20 hover:border-azure hover:text-azure transition-colors"
              >
                {p.label}
              </button>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ══ Main Content Area ═══════════════════════════════════════════════════ -->
  <main id="fonts-scope" class="fonts-scope flex-1 bg-bg-page" data-latin-mode="match" data-variable="true">

    <!-- DESK VIEW (Default) -->
    <div id="view-desk" class="block">
      <DeskPage
        desk={desk}
        page={page}
        videos={allVideos.slice(0, 5)}
        trending={latest.slice(0, 5)}
        latest={latest.slice(5, 11)}
      />
    </div>

    <!-- SPECIMEN VIEW -->
    <div id="view-specimen" class="hidden max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">

      <!-- Specimen Header -->
      <section class="border-b border-rule dark:border-ivory/10 pb-8">
        <span class="eyebrow text-azure dark:text-azure-light">Type Specimen Sheet</span>
        <h2 class="mt-2 text-4xl sm:text-6xl font-bold tracking-tight text-text-primary font-malayalam">
          കേരളം: സമഗ്ര വാര്‍ത്തകളും വിശകലനങ്ങളും
        </h2>
        <p class="mt-4 text-xl sm:text-2xl text-text-secondary max-w-[50ch] font-malayalam leading-relaxed">
          MediaOne News Kerala Desk — Rendered live with <span id="active-mal-name" class="font-bold text-azure">Malini</span> and <span id="active-lat-name" class="font-bold text-azure">Anek Latin</span>.
        </p>
      </section>

      <!-- Specimen Scales Grid -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Display Headlines -->
        <div class="space-y-6 border border-rule dark:border-ivory/10 p-6 bg-bg-card">
          <h3 class="eyebrow text-azure border-b border-rule dark:border-ivory/10 pb-2">Headline Hierarchy</h3>

          <div>
            <p class="caption-text text-text-muted">Display 72px / Bold</p>
            <h1 class="text-5xl font-bold leading-tight text-text-primary font-malayalam">
              നിയമസഭാ തെരഞ്ഞെടുപ്പ്: തീയതി പ്രഖ്യാപിച്ചു
            </h1>
          </div>

          <div>
            <p class="caption-text text-text-muted">Section 40px / SemiBold</p>
            <h2 class="text-3xl font-semibold leading-snug text-text-primary font-malayalam">
              ബജറ്റ് സമ്മേളനത്തിന് ഇന്ന് തുടക്കമാകും; പ്രതിപക്ഷം പ്രതിഷേധത്തിന്
            </h2>
          </div>

          <div>
            <p class="caption-text text-text-muted">Card Title 24px / Medium</p>
            <h3 class="text-xl font-medium leading-normal text-text-primary font-malayalam">
              സംസ്ഥാനത്ത് മഴ മുന്നറിയിപ്പ്: നാല് ജില്ലകളിൽ യെല്ലോ അലർട്ട്
            </h3>
          </div>
        </div>

        <!-- Body & Paragraphs -->
        <div class="space-y-6 border border-rule dark:border-ivory/10 p-6 bg-bg-card">
          <h3 class="eyebrow text-azure border-b border-rule dark:border-ivory/10 pb-2">Body Text & Reading Comfort</h3>

          <div>
            <p class="caption-text text-text-muted font-sans">Malayalam Paragraph (18px / Regular)</p>
            <p class="mt-1 text-lg leading-relaxed text-text-primary font-malayalam">
              തിരുവനന്തപുരം: സംസ്ഥാനത്ത് വിവിധ വികസന പദ്ധതികളുടെ ഉദ്ഘാടനം മുഖ്യമന്ത്രി നിർവഹിച്ചു. പൊതുജനങ്ങളുടെ അടിസ്ഥാന സൌകര്യങ്ങൾ മെച്ചപ്പെടുത്തുന്നതിനാണ് സർക്കാർ മുൻഗണന നൽകുന്നതെന്ന് അദ്ദേഹം പറഞ്ഞു.
            </p>
          </div>

          <div>
            <p class="caption-text text-text-muted">Mixed Malayalam &amp; Latin (16px / Regular)</p>
            <p class="mt-1 text-base leading-relaxed text-text-primary font-malayalam">
              MediaOne TV News Kerala: ഡിജിറ്റൽ യുഗത്തിൽ വാർത്തകൾ അതിവേഗം ജനങ്ങളിലേക്ക് എത്തിക്കാൻ പുതിയ AI സാങ്കേതികവിദ്യകൾ ഉപയോഗപ്പെടുത്തുന്നു. Chief Editor വിനോദ് ചന്ദ്രൻ വ്യക്തമാക്കി.
            </p>
          </div>

          <div>
            <p class="caption-text text-text-muted">Meta &amp; Timestamps (13px / Medium)</p>
            <p class="mt-1 text-xs font-medium text-text-muted font-malayalam">
              Published on 17 August 2026 · Updated 5 mins ago · MediaOne Special Desk
            </p>
          </div>
        </div>

      </section>

      <!-- Alphabet & Glyphs Specimen -->
      <section class="border border-rule dark:border-ivory/10 p-6 bg-bg-card space-y-4">
        <h3 class="eyebrow text-azure border-b border-rule dark:border-ivory/10 pb-2">Glyphs & Character Set</h3>
        <p class="text-2xl leading-loose font-malayalam text-text-primary tracking-wide">
          അ ആ ഇ ഈ ഉ ഊ ഋ എ ഏ ഐ ഒ ഓ ഔ അം അഃ
          <br />
          ക ഖ ഗ ഘ ങ ച ഛ ജ ഝ ഞ ട ഠ ഡ ഢ ണ ത ഥ ദ ധ ന പ ഫ ബ ഭ മ യ ര ല വ ശ ഷ സ ഹ ള ഴ റ റ്റ ന്റ
          <br />
          ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789
        </p>
      </section>

    </div>

  </main>

  <Footer />
</Layout>

<script is:inline>
  (function () {
    var scope = document.getElementById('fonts-scope');
    var controls = document.getElementById('fonts-controls');
    var viewDesk = document.getElementById('view-desk');
    var viewSpecimen = document.getElementById('view-specimen');
    var activeMalName = document.getElementById('active-mal-name');
    var activeLatName = document.getElementById('active-lat-name');

    if (!scope || !controls) return;

    var SUFFIX = { wght: '', wdth: '%', slnt: '°' };
    var staticNote = controls.querySelector('[data-static-note]');

    var currentMalBtn = controls.querySelector('[data-face="malini"]');
    var currentLatBtn = controls.querySelector('[data-latin-face="match"]');

    function getAxisRows() {
      return Array.prototype.slice.call(controls.querySelectorAll('[data-axis-row]'));
    }

    function applyStack() {
      if (!currentMalBtn) return;

      var malFamily = currentMalBtn.getAttribute('data-family');
      var malMl = currentMalBtn.getAttribute('data-ml');
      var latFaceId = currentLatBtn ? currentLatBtn.getAttribute('data-latin-face') : 'match';
      var latFamily = currentLatBtn ? currentLatBtn.getAttribute('data-latin-family') : '';

      var stack = '';

      if (latFaceId === 'match') {
        // Match Malayalam: use the full Malayalam typeface (including its Latin)
        stack = '"' + malFamily + '", "Anek Malayalam", system-ui, sans-serif';
      } else if (latFamily) {
        // Specific Latin family chosen: place Latin family first, then Malayalam-only twin (if available) or full Malayalam family
        var mlTarget = malMl || malFamily;
        stack = '"' + latFamily + '", "' + mlTarget + '", "Anek Malayalam", system-ui, sans-serif';
      } else {
        stack = '"' + malFamily + '", "Anek Malayalam", system-ui, sans-serif';
      }

      scope.style.setProperty('--trial-stack', stack);

      if (activeMalName) activeMalName.textContent = currentMalBtn.getAttribute('data-family');
      if (activeLatName) activeLatName.textContent = latFamily || (currentMalBtn.getAttribute('data-family') + ' Latin');
    }

    function setAxis(id, value) {
      scope.style.setProperty('--trial-' + id, String(value));
      var out = controls.querySelector('[data-axis-out="' + id + '"]');
      var input = controls.querySelector('[data-axis="' + id + '"]');
      if (input) input.value = value;
      if (out) out.textContent = value + (SUFFIX[id] || '');
      if (id === 'wght') scope.style.fontWeight = value;
    }

    function selectMalayalamFace(btn) {
      currentMalBtn = btn;
      controls.querySelectorAll('[data-face]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b === btn));
      });

      var axes = JSON.parse(btn.getAttribute('data-axes') || 'null');
      scope.setAttribute('data-variable', String(!!axes));
      if (staticNote) staticNote.hidden = !!axes;

      getAxisRows().forEach(function (row) {
        var id = row.getAttribute('data-axis-row');
        var spec = axes && axes[id];
        var input = row.querySelector('input');

        row.classList.toggle('opacity-30', !spec);
        row.classList.toggle('pointer-events-none', !spec);

        if (spec) {
          input.min = spec[0];
          input.max = spec[1];
          setAxis(id, spec[2]);
        } else if (id === 'wght' && !axes) {
          row.classList.remove('opacity-30', 'pointer-events-none');
          input.min = 400; input.max = 700; input.step = 300;
          setAxis('wght', 400);
        } else {
          setAxis(id, id === 'wdth' ? 100 : 0);
        }
      });

      applyStack();
    }

    function selectLatinFace(btn) {
      currentLatBtn = btn;
      controls.querySelectorAll('[data-latin-face]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b === btn));
      });
      applyStack();
    }

    function selectPreset(presetBtn) {
      var malId = presetBtn.getAttribute('data-preset-mal');
      var latId = presetBtn.getAttribute('data-preset-lat');
      var wghtVal = presetBtn.getAttribute('data-preset-wght');

      var targetMal = controls.querySelector('[data-face="' + malId + '"]');
      var targetLat = controls.querySelector('[data-latin-face="' + latId + '"]');

      if (targetMal) selectMalayalamFace(targetMal);
      if (targetLat) selectLatinFace(targetLat);
      if (wghtVal) setAxis('wght', wghtVal);
    }

    // View Mode Toggle listener
    document.querySelectorAll('[data-view]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var view = btn.getAttribute('data-view');
        document.querySelectorAll('[data-view]').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b === btn));
        });
        if (view === 'desk') {
          if (viewDesk) viewDesk.classList.remove('hidden');
          if (viewSpecimen) viewSpecimen.classList.add('hidden');
        } else {
          if (viewDesk) viewDesk.classList.add('hidden');
          if (viewSpecimen) viewSpecimen.classList.remove('hidden');
        }
      });
    });

    // Control Listeners
    controls.addEventListener('input', function (e) {
      var id = e.target.getAttribute && e.target.getAttribute('data-axis');
      if (id) setAxis(id, e.target.value);
    });

    controls.addEventListener('click', function (e) {
      var malBtn = e.target.closest('[data-face]');
      if (malBtn) return selectMalayalamFace(malBtn);

      var latBtn = e.target.closest('[data-latin-face]');
      if (latBtn) return selectLatinFace(latBtn);

      var presetBtn = e.target.closest('[data-preset]');
      if (presetBtn) return selectPreset(presetBtn);
    });

    // Initialize default face
    selectMalayalamFace(currentMalBtn);
  })();
</script>
