---
// ── /new ─────────────────────────────────────────────────────────────────────
// The homepage stripped to its opening: the same masthead, the same lead
// package, the same footer, and nothing after it. A working ground for the next
// band — what gets built here lands under the lead and is read against the real
// chrome above and below it, rather than against an empty page.
//
// Everything it renders is imported from the homepage's own parts and fed the
// same data (src/lib/home4-data.ts), so it does not drift: change a band on /
// and this page changes with it. Keep the two headers' props identical — the
// lead package reads them (see LIVE_IN_HEADER / TOPICS_IN_HEADER below).
import Layout from '../layouts/Layout.astro';
import Header from '../components/nav/HeaderBar.astro';
import Footer from '../components/Footer.astro';
import VideoModal from '../components/VideoModal.astro';
import ScheduleList from '../components/live/ScheduleList.astro';
import LeadPackage from '../components/home4/LeadPackage.astro';

import { leadStories, latest, feed } from '../lib/home4-data';
import { allVideos, todaysVideos } from '../lib/videos';
import { toModalVideos, modalShows, type ModalVideo } from '../lib/video-modal';
import { trendingTopics } from '../lib/mega-nav';
import { LIVE_CHANNEL } from '../lib/live-tv';

// The same two placements the homepage makes, held in step with it: the
// masthead carries the on-air control and the trending strip, so the lead
// package renders neither.
const LIVE_IN_HEADER = true;
const TOPICS_IN_HEADER = true;

const [hero, ...heroRest] = leadStories;

// The player the masthead's Live control opens. Without it that control would
// fall back to navigating to /live here while it opens in place on the
// homepage — the same button behaving differently on two pages.
const modalToday = todaysVideos().map((v) => ({
  id: v.slug,
  title: v.title,
  time: v.publishTime,
  poster: v.thumbnailUrl || '',
}));
const shows = await modalShows();

const liveModalVideo: ModalVideo = {
  id: LIVE_CHANNEL.id,
  title: `${LIVE_CHANNEL.titleML} | ${LIVE_CHANNEL.title}`,
  category: 'Live TV',
  meta: 'Streaming now · 24×7',
  poster: LIVE_CHANNEL.poster,
  src: '',
  embedUrl: LIVE_CHANNEL.embedUrl,
  isLive: true,
};
---

<Layout
  title="MediaOne | വാർത്തകൾ, ലൈവ് ടിവി, വിശകലനം"
  description="വാർത്തകൾ, ലൈവ് ടിവി, വിശകലനം — കേരളം, ഇന്ത്യ, ഗൾഫ്, ലോകം. MediaOne: Malayalam news, live TV and analysis."
  adTone="gray"
>
  <Header isBreaking={false} showTopics={TOPICS_IN_HEADER} liveUnit={LIVE_IN_HEADER} />

  <main class="flex-1 bg-bg-page">
    <div class="w-full max-w-site mx-auto bg-bg-card">
      <div class="px-4 sm:px-6 lg:px-8">
        <!-- 1 · LEAD — the homepage's opening band, on the homepage's data -->
        <LeadPackage
          lead={hero}
          rows={[...heroRest, ...latest]}
          feed={feed}
          topics={TOPICS_IN_HEADER ? [] : trendingTopics}
          onAir={!LIVE_IN_HEADER}
          flushTop
        />
      </div>

      <!-- The next band goes here. -->
    </div>
  </main>

  <Footer />

  <VideoModal videos={[liveModalVideo, ...toModalVideos(allVideos)]} today={modalToday} programs={shows}>
    <ScheduleList slot="live-panel" tone="dark" />
  </VideoModal>
</Layout>
